#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Inspect and operate desktop applications through AT-SPI (run as the desktop user).

  rungic-a11y enable|disable|state      org.a11y.Status IsEnabled (Qt apps register live)
  rungic-a11y apps                      registered applications
  rungic-a11y windows                   KWin window list with global logical geometry
  rungic-a11y tree APP [--depth N] [--all]
  rungic-a11y find APP [--role R] [--name REGEX] [--all]
  rungic-a11y act APP PATH [--action NAME]
  rungic-a11y text APP PATH TEXT

Output is JSON. PATH is the child-index path printed by tree/find ("0/2/5");
it is only stable while the UI does not change, so find again after actions.
Only showing nodes are listed unless --all. Extents are window coordinates:
Wayland does not give clients global positions.

Accessibility has a cost in every registered app; `disable` after automation
and record the state when measuring performance.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import time

import gi
gi.require_version('Atspi', '2.0')
from gi.repository import Atspi  # noqa: E402


def set_enabled(value):
    subprocess.run(['busctl', '--user', 'set-property', 'org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Status',
                    'IsEnabled', 'b', 'true' if value else 'false'], check=True)


def enabled():
    out = subprocess.run(['busctl', '--user', 'get-property', 'org.a11y.Bus', '/org/a11y/bus', 'org.a11y.Status',
                          'IsEnabled'], check=True, capture_output=True, text=True).stdout
    return out.strip() == 'b true'


KWIN_SCRIPT = '''const list = workspace.windowList().map(w => ({id: String(w.internalId), caption: w.caption, pid: w.pid,
  resource_class: w.resourceClass, normal: w.normalWindow, active: w.active, minimized: w.minimized,
  x: w.frameGeometry.x, y: w.frameGeometry.y, w: w.frameGeometry.width, h: w.frameGeometry.height}));
print("TOKEN " + JSON.stringify(list));
'''


def windows():
    """Wayland clients cannot learn their global position; ask KWin through a one-shot script."""
    token = f'motowin{os.getpid()}x{time.monotonic_ns()}'
    qdbus = lambda *a: subprocess.run(['qdbus6', 'org.kde.KWin', *a], check=True, capture_output=True,
                                      text=True).stdout.strip()
    with tempfile.NamedTemporaryFile('w', suffix='.js', delete=False) as script:
        script.write(KWIN_SCRIPT.replace('TOKEN', token))
    try:
        number = qdbus('/Scripting', 'org.kde.kwin.Scripting.loadScript', script.name, token)
        qdbus(f'/Scripting/Script{number}', 'org.kde.kwin.Script.run')
        for _ in range(30):  # KWin prints to its journal stream
            time.sleep(0.1)
            found = subprocess.run(['journalctl', '-b', '--since=-30s', '-o', 'cat', '--grep', token],
                                   capture_output=True, text=True).stdout
            if token in found:
                return json.loads(found.split(token + ' ', 1)[1].splitlines()[0])
        raise SystemExit('KWin window list not found in the journal')
    finally:
        subprocess.run(['qdbus6', 'org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting.unloadScript', token],
                       capture_output=True)
        os.unlink(script.name)


def app(name):
    desktop = Atspi.get_desktop(0)
    matches = [desktop.get_child_at_index(i) for i in range(desktop.get_child_count())]
    matches = [a for a in matches if a is not None and (a.get_name() == name or str(a.get_process_id()) == name)]
    if not matches:
        raise SystemExit(f'no accessible application {name!r}; run `rungic-a11y apps` (is accessibility enabled?)')
    return matches[0]


def node(acc, path):
    states = acc.get_state_set()
    info = {'path': path, 'role': acc.get_role_name(), 'name': acc.get_name() or '',
            'states': [s for s in ('showing', 'visible', 'focused', 'enabled', 'checked', 'selected', 'editable')
                       if states.contains(getattr(Atspi.StateType, s.upper()))]}
    if acc.get_description():
        info['description'] = acc.get_description()
    try:
        # A control's identifier (Qt: Accessible.id) stays the same in every interface language.
        if acc.get_accessible_id():
            info['id'] = acc.get_accessible_id()
    except Exception:
        pass
    try:
        box = acc.get_extents(Atspi.CoordType.WINDOW)
        info['extents'] = [box.x, box.y, box.width, box.height]
    except Exception:
        pass
    try:
        action = acc.get_action_iface()
        if action:
            info['actions'] = [action.get_action_name(i) for i in range(action.get_n_actions())]
    except Exception:
        pass
    try:
        text = acc.get_text_iface()
        if text:
            # Atspi.Text's own methods: on the object, get_text() is the deprecated Accessible.get_text()
            # (no arguments), which failed here so that no element ever showed its text.
            info['text'] = Atspi.Text.get_text(text, 0, min(Atspi.Text.get_character_count(text), 200))
    except Exception:
        pass
    return info


def walk(acc, path='', depth=0, max_depth=40, include_hidden=False):
    for i in range(acc.get_child_count()):
        child = acc.get_child_at_index(i)
        if child is None:
            continue
        child_path = f'{path}/{i}' if path else str(i)
        showing = child.get_state_set().contains(Atspi.StateType.SHOWING)
        if not include_hidden and not showing and child.get_role() != Atspi.Role.APPLICATION:
            continue
        yield depth, child, child_path
        if depth < max_depth:
            yield from walk(child, child_path, depth + 1, max_depth, include_hidden)


def resolve(root, path):
    acc = root
    for index in path.split('/'):
        acc = acc.get_child_at_index(int(index))
        if acc is None:
            raise SystemExit(f'path {path} no longer exists; find the element again')
    return acc


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='cmd', required=True)
    for name in ('enable', 'disable', 'state', 'apps', 'windows'):
        sub.add_parser(name)
    p = sub.add_parser('tree'); p.add_argument('app'); p.add_argument('--depth', type=int, default=40)
    p.add_argument('--all', action='store_true')
    p = sub.add_parser('find'); p.add_argument('app'); p.add_argument('--role'); p.add_argument('--name')
    p.add_argument('--all', action='store_true')
    p = sub.add_parser('act'); p.add_argument('app'); p.add_argument('path'); p.add_argument('--action')
    p = sub.add_parser('text'); p.add_argument('app'); p.add_argument('path'); p.add_argument('text')
    a = parser.parse_args()
    if a.cmd in ('enable', 'disable'):
        set_enabled(a.cmd == 'enable')
        result = {'enabled': enabled()}
    elif a.cmd == 'state':
        result = {'enabled': enabled()}
    elif a.cmd == 'windows':
        result = windows()
    elif a.cmd == 'apps':
        desktop = Atspi.get_desktop(0)
        result = [{'name': c.get_name(), 'pid': c.get_process_id(), 'windows': c.get_child_count()}
                  for c in (desktop.get_child_at_index(i) for i in range(desktop.get_child_count())) if c]
    elif a.cmd == 'tree':
        result = [{'depth': d, **node(acc, path)} for d, acc, path in walk(app(a.app), max_depth=a.depth,
                                                                           include_hidden=a.all)]
    elif a.cmd == 'find':
        pattern = re.compile(a.name, re.I) if a.name else None
        result = [node(acc, path) for _, acc, path in walk(app(a.app), include_hidden=a.all)
                  if (not a.role or acc.get_role_name() == a.role)
                  and (not pattern or pattern.search(acc.get_name() or ''))]
    elif a.cmd == 'act':
        acc = resolve(app(a.app), a.path)
        action = acc.get_action_iface()
        if not action or not action.get_n_actions():
            raise SystemExit('element has no actions')
        names = [action.get_action_name(i) for i in range(action.get_n_actions())]
        index = names.index(a.action) if a.action else 0
        result = {'element': node(acc, a.path), 'action': names[index], 'ok': action.do_action(index)}
    else:
        acc = resolve(app(a.app), a.path)
        editable = acc.get_editable_text_iface()
        if not editable:
            raise SystemExit('element is not editable text')
        result = {'element': node(acc, a.path), 'ok': editable.set_text_contents(a.text)}
    json.dump(result, sys.stdout, ensure_ascii=False, indent=1)
    print()


if __name__ == '__main__':
    main()
