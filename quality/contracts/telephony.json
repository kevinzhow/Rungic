{
  "interface": "telephony",
  "comment": "Android provides mobile network state and calls to Linux consumers. AndroidTelephonyBridge handles `op: telephony` on the platform socket, `$RUNGIC_PLATFORM_SOCKET`. Each direction sends one JSON object per line. Each connection carries one request.\n\nThe `state` action supplies data to `shared/platform/modem-manager.py` and `network-manager.py`. A phone without a modem returns only `modem: false`. The `data` action changes Android's mobile data switch.\n\nThe root call daemon, `com.rungic.telephony.CallDaemon`, uses the abstract socket `com.rungic.calls.v1`. Its consumers are `agent/assistant/cellular_audio.py` and `cellular_call.py`. They trust the server only if its UID is 0.\n\nThe `status` action lists calls. Android adds `available: false` if no InCallService is bound. The actions `dial`, `hangup`, `answer`, `dtmf`, `show-linux` and `audio` change state. The provider check never sends them.\n\nAndroidSmsBridge handles `op: sms` on the platform socket. `rungic-sms` sends messages and filters messages from the provider. Radio completion and delivery receipt are separate events. The provider check never sends an SMS.\n\nConsumer checks use `tools/tests/test_cellular_state.py`, `test_cellular_audio.py` and `test_contract_network.py`. Acceptance scenario `contract.telephony` checks the Rungic app and call daemon on the phone. That check blanks call numbers on the phone.",
  "sockets": {
    "platform": {
      "path": "/mnt/android-wayland/platform.sock",
      "env": "RUNGIC_PLATFORM_SOCKET"
    },
    "calls": {
      "abstract": "com.rungic.calls.v1",
      "peer_uid": 0
    }
  },
  "queries": [
    {
      "name": "state",
      "request": {
        "op": "telephony",
        "action": "state"
      },
      "replies": [
        {
          "modem": true,
          "manufacturer": "motorola",
          "model": "XT2537-4",
          "sim": "ready",
          "slots": 2,
          "simOperator": "46001",
          "simOperatorName": "China Unicom",
          "operator": "46001",
          "operatorName": "CHN-UNICOM",
          "service": 0,
          "roaming": false,
          "level": 3,
          "dataType": 13,
          "dataEnabled": true,
          "dataConnected": true,
          "dataRoaming": false
        },
        {
          "modem": false,
          "manufacturer": "motorola",
          "model": "XT2537-4"
        }
      ],
      "read_only": true
    },
    {
      "name": "data",
      "request": {
        "op": "telephony",
        "action": "data",
        "on": true
      },
      "match": [
        "op",
        "action"
      ],
      "reply": {
        "accepted": true
      },
      "read_only": false
    },
    {
      "name": "call-status",
      "socket": "calls",
      "request": {
        "op": "status"
      },
      "reply": {
        "protocol": 1,
        "phoneState": 0,
        "audioCapable": true,
        "calls": [
          {
            "id": "call-1",
            "state": 4
          }
        ]
      },
      "private": [
        "calls"
      ],
      "read_only": true
    },
    {
      "name": "sms-send",
      "request": {
        "op": "sms",
        "action": "send",
        "to": "10000",
        "text": "查询话费"
      },
      "match": [
        "op",
        "action"
      ],
      "replies": [
        {
          "status": "sent",
          "parts": 1,
          "submittedAt": 1,
          "sentParts": 1,
          "subscription": 1,
          "delivery": "unconfirmed",
          "delivered": false
        },
        {
          "status": "failed",
          "parts": 1,
          "submittedAt": 1,
          "sentParts": 0,
          "subscription": 1,
          "error": "no-service"
        },
        {
          "status": "pending",
          "parts": 1,
          "submittedAt": 1,
          "sentParts": 0,
          "subscription": 1,
          "error": "Radio result unknown"
        },
        {
          "error": "No active default SMS SIM"
        }
      ],
      "read_only": false,
      "timeout": 75
    },
    {
      "name": "sms-list",
      "request": {
        "op": "sms",
        "action": "list",
        "box": "inbox",
        "limit": 1,
        "from": "10000"
      },
      "match": [
        "op",
        "action"
      ],
      "reply": {
        "messages": [
          {
            "id": 1,
            "address": "10000",
            "text": "example",
            "date": 1,
            "box": "inbox",
            "read": false
          }
        ],
        "truncated": false
      },
      "private": [
        "messages"
      ],
      "read_only": true,
      "timeout": 15
    }
  ]
}
