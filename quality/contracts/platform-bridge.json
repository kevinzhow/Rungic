{
  "interface": "platform-bridge",
  "comment": "This contract defines read-only platform queries and the reply fields that Linux consumers require. See `quality/interfaces.yaml`.\n\nReplies must include every key from the example. Each value must have the example's type. An example value of null permits any value, including null. For `display-get`, `refreshPolicy` 0 means automatic. Other values specify a fixed rate in Hz.\n\nThe transport uses a Unix stream socket. Each direction sends one JSON object per line. Each connection carries one request. Errors use {\"error\": string}. The socket is `$RUNGIC_PLATFORM_SOCKET`. Its default container path is `/mnt/android-wayland/platform.sock`.\n\nThis contract contains only read-only queries. The phone's provider check sends queries with `read_only` set to true.\n\n`tools/tests/test_platform_bridge_contract.py` checks consumers against the substitute in `tools/contracts.py`. Acceptance scenario `contract.platform-bridge` checks the Rungic app on the phone.",
  "queries": [
    {
      "name": "status",
      "request": {
        "op": "status"
      },
      "reply": {
        "version": 1,
        "model": "XT2537-4",
        "android": "16",
        "orientation": "portrait",
        "foreground": true,
        "keepAwake": false
      },
      "read_only": true
    },
    {
      "name": "display-get",
      "request": {
        "op": "display-get"
      },
      "reply": {
        "version": 1,
        "physicalWidth": 1080,
        "physicalHeight": 2400,
        "densityDpi": 400,
        "renderWidth": 1080,
        "renderHeight": 2400,
        "refreshRates": [
          60,
          120
        ],
        "refreshPolicy": 0,
        "currentRefresh": 120.0
      },
      "read_only": true
    },
    {
      "name": "brightness-get",
      "request": {
        "op": "brightness-get"
      },
      "reply": {
        "level": 40,
        "followAndroid": true
      },
      "read_only": true
    },
    {
      "name": "desktop-mode",
      "request": {
        "op": "desktop-mode"
      },
      "reply": {
        "enabled": false,
        "width": 1920,
        "height": 1080,
        "tv": false,
        "watched": false
      },
      "read_only": true
    },
    {
      "name": "agent-screen",
      "request": {
        "op": "agent-screen"
      },
      "reply": {
        "enabled": false,
        "workspace": 1,
        "width": 1920,
        "height": 1080,
        "tv": false,
        "tvShown": [],
        "tvHeard": -1,
        "directorFocus": 1
      },
      "read_only": true
    },
    {
      "name": "tv",
      "request": {
        "op": "tv"
      },
      "reply": {
        "members": [],
        "focus": 1,
        "level": 0,
        "version": 0,
        "tv": {
          "connected": false,
          "content": null,
          "shown": [],
          "heard": -1
        },
        "picking": false
      },
      "read_only": true
    },
    {
      "name": "director",
      "request": {
        "op": "director"
      },
      "reply": {
        "members": [],
        "focus": 1,
        "level": 0,
        "version": 0,
        "tv": {
          "connected": false,
          "content": null,
          "shown": [],
          "heard": -1
        }
      },
      "read_only": true
    },
    {
      "name": "capture-info",
      "request": {
        "op": "capture-info"
      },
      "reply": {
        "version": 1,
        "visible": true,
        "microphonePermission": true,
        "microphoneActive": false,
        "cameraActive": false,
        "cameraPermission": true,
        "cameraDenied": false,
        "microphoneDenied": false,
        "communication": {
          "version": 1,
          "active": false,
          "aecAvailable": true,
          "playbackCursor": true
        },
        "cameras": [
          {
            "id": "0",
            "facing": "back",
            "width": 1280,
            "height": 720,
            "rotation": 90,
            "fps": 30
          },
          {
            "id": "1",
            "facing": "front",
            "width": 1280,
            "height": 720,
            "rotation": 270,
            "fps": 30
          }
        ]
      },
      "read_only": true
    }
  ]
}
