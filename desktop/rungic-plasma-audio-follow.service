[Unit]
Description=Sound where its picture is while casting (docs/58)
After=pulseaudio.service plasma-kwin_wayland.service rungic-plasma-media.service
Wants=pulseaudio.service
PartOf=graphical-session.target

[Service]
# After= orders processes; KWin can still be initializing before it owns its D-Bus name.
ExecStartPre=/usr/libexec/rungic-wait-dbus org.kde.KWin
ExecStart=/usr/bin/rungic-audio-follow
TimeoutStartSec=180
Restart=on-failure
RestartSec=5

[Install]
WantedBy=plasma-workspace.target
