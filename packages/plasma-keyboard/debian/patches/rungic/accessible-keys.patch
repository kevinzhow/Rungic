diff --git a/src/qmlplugin/BreezeKeyPanel.qml b/src/qmlplugin/BreezeKeyPanel.qml
index 0078f80..726453e 100644
--- a/src/qmlplugin/BreezeKeyPanel.qml
+++ b/src/qmlplugin/BreezeKeyPanel.qml
@@ -29,6 +29,15 @@ KeyPanel {
         return BreezeConstants.normalKeyBackgroundColor;
     }
 
+    // Screen readers and UI tests see each key as a button: the name says what it types or does,
+    // the identifier stays the same in every interface language. Passive: no accessible action, a
+    // key is still pressed only by touching it.
+    property string accessibleName: control ? (control.uppercased ? control.displayText.toUpperCase() : control.displayText) : ""
+    property string accessibleId: control && control.text ? "key:" + control.text : "key"
+    Accessible.role: Accessible.Button
+    Accessible.name: accessibleName
+    Accessible.id: accessibleId
+
     soundEffect: PlasmaKeyboardSettings.soundEnabled ? Qt.resolvedUrl('qrc:///sounds/keyboard_tick2_quiet.wav') : ''
 
     QQC2.Control {
