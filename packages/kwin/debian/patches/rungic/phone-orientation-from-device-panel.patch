-                    {QStringLiteral("op"), QStringLiteral("orientation")},
-                    {QStringLiteral("mode"), landscape ? QStringLiteral("portrait") : QStringLiteral("landscape")}});
-                if (reply.contains(QStringLiteral("error"))) {
-                    qCWarning(KWIN_WAYLAND_BACKEND) << "Android did not turn the phone:" << reply;
-                    return OutputConfigurationError::Unknown;
-                }
+                // The phone's orientation is the user's setting in the device panel (Android turns its
+                // window, and the host offers the turned size, taken as any host resize; docs/50). A
