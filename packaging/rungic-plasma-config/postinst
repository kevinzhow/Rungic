#!/bin/sh
# dpkg path filters apply on unpack, so also remove files installed before our
# config package. Only exact standalone-app paths are listed in this policy.
if [ "$1" = configure ]; then
    sed -n 's|^path-exclude=\(/.*\)$|\1|p' /etc/dpkg/dpkg.cfg.d/zz-rungic-apps |
    while IFS= read -r path; do
        rm -f -- "$path"
    done
fi
# The critical power action used to be set by editing Ubuntu's UPower.conf; the drop-in in
# UPower.conf.d carries it now, so the packaged file goes back to its defaults.
if [ "$1" = configure ] && [ -f /etc/UPower/UPower.conf ]; then
    sed -i -e 's/^AllowRiskyCriticalPowerAction=true$/AllowRiskyCriticalPowerAction=false/' \
           -e 's/^CriticalPowerAction=Ignore$/CriticalPowerAction=HybridSleep/' /etc/UPower/UPower.conf
fi
# The machine-local APT proxy (set up by hand, rungic-local-config.json) under its Rungic name
# (docs/70). The old file stays for a rollback; both hold the same settings.
if [ "$1" = configure ] && [ -f /etc/apt/apt.conf.d/80moto-proxy ] && [ ! -e /etc/apt/apt.conf.d/80rungic-proxy ]; then
    cp -p /etc/apt/apt.conf.d/80moto-proxy /etc/apt/apt.conf.d/80rungic-proxy
fi
# Services' defaults (docs/83): kept off, masked, or on (SSH). Each unit's default from service-policy.json is applied
# once and recorded; a unit already recorded is left as it is, so what the user turned on or off in
# Settings -> Services survives upgrades. Up to 0.305 this package owned the masks itself: the
# upgrade has just removed them, and the first run here puts them back as local state.
if [ "$1" = configure ]; then
    state=/var/lib/rungic/service-defaults
    mkdir -p /var/lib/rungic /etc/systemd/system /etc/systemd/user
    touch "$state"
    changed=
    for entry in $(python3 -c '
import json
for g in json.load(open("/usr/share/rungic/service-policy.json"))["groups"]:
    for scope in ("system", "user"):
        for unit in g.get(scope, []):
            print(scope + "/" + unit + "/" + g["default"])'); do
        scope=${entry%%/*}; rest=${entry#*/}; unit=${rest%/*}; default=${rest#*/}
        grep -qxF "$scope $unit" "$state" && continue
        # A unit another package ships (Linux's own network, rungic-plasma-bridges) may not be
        # installed yet: not recorded, so that package applies its default when it is.
        case $default in enabled|disabled)
            [ -e "/usr/lib/systemd/$scope/$unit" ] || [ -e "/lib/systemd/$scope/$unit" ] || continue ;;
        esac
        case $default in
            masked)
                if [ ! -e "/etc/systemd/$scope/$unit" ] && [ ! -L "/etc/systemd/$scope/$unit" ]; then
                    ln -s /dev/null "/etc/systemd/$scope/$unit"
                fi ;;
            disabled)
                # Ubuntu's openssh-server enables ssh.socket; deb-systemd-helper records the
                # disable, so that package's own upgrades keep it off.
                if [ "$scope" = system ]; then deb-systemd-helper disable "$unit" >/dev/null 2>&1 || true; fi ;;
            enabled)
                # On, and the user may turn it off (SSH, AGENTS.md 2026-09-29): recorded as enabled.
                if [ "$scope" = system ]; then deb-systemd-helper enable "$unit" >/dev/null 2>&1 || true; fi ;;
        esac
        echo "$scope $unit" >> "$state"
        changed=1
    done
    if [ -n "$changed" ] && [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        for dir in /run/user/*; do
            uid=${dir##*/}; [ -S "$dir/systemd/private" ] || continue
            name=$(getent passwd "$uid" | cut -d: -f1); [ -n "$name" ] || continue
            runuser -u "$name" -- env XDG_RUNTIME_DIR="$dir" systemctl --user daemon-reload || true
        done
    fi
fi
# One-time migrations of the container's system (docs/122), after the defaults above. A failure is
# logged and retried at the next configure; it does not fail the upgrade.
if [ "$1" = configure ]; then
    /usr/libexec/rungic-migrate /usr/lib/rungic/migrations/system /var/lib/rungic/migrations ||
        echo 'rungic-migrate: a migration failed; it runs again at the next upgrade' >&2
fi
