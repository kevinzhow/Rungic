#!/bin/sh
# deb-systemd-helper can keep an enabled unit's old WantedBy links while recording
# the new target without creating its link. Refresh links only if still enabled;
# an administrator's disabled or masked service stays that way.
if [ "$1" = configure ] && [ -z "${DPKG_ROOT:-}" ] && command -v systemctl >/dev/null 2>&1; then
    if systemctl --global is-enabled --quiet rungic-voice-agent.service; then
        systemctl --global enable rungic-voice-agent.service >/dev/null || true
    fi
fi
