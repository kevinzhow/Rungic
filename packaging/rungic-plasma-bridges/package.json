{
  "name": "rungic-plasma-bridges",
  "formerly": "moto-plasma-bridges",
  "architecture": "arm64",
  "build": "device",
  "paths": [
    "desktop/device-panel.py",
    "desktop/com.rungic.Platform.desktop",
    "desktop/po/zh_CN/rungic-platform.po",
    "desktop/po/zh_CN/rungic-render.po",
    "shared/platform",
    "shared/media/media-bridge.py",
    "shared/media/audio-route.py",
    "shared/media/audio-follow.py",
    "shared/media/camera-source.cpp",
    "shared/po",
    "desktop/rungic-plasma-network.service",
    "desktop/rungic-plasma-bluetooth.service",
    "desktop/rungic-plasma-modem.service",
    "desktop/rungic-plasma-media.service",
    "desktop/rungic-plasma-clipboard.service",
    "desktop/rungic-plasma-audio-follow.service",
    "shared/media/communication-audio.cpp",
    "desktop/rungic-communication-audio.service",
    "desktop/rungic-own-network.service",
    "desktop/rungic-network-mode.service",
    "desktop/rungic-network-mode.path"
  ],
  "depends": "libglib2.0-bin, rungic-plasma-config, python3, python3-gi, python3-dbus, gir1.2-adw-1, pulseaudio-utils, pipewire, bluedevil, gstreamer1.0-plugins-bad, passt, util-linux",
  "build_depends": [
    "libpipewire-0.3-dev",
    "libjson-glib-dev",
    "libyuv-dev",
    "pkgconf",
    "g++",
    "gettext",
    "qt6-base-dev",
    "libgstreamer1.0-dev",
    "libgstreamer-plugins-base1.0-dev"
  ],
  "description": "Plasma Mobile on Android: Android bridges\nThe Android device panel, clipboard, Wi-Fi and network for NetworkManager clients,\nBluetooth for BlueZ clients (bluedevil), the mobile network\nfor ModemManager clients, the\nmicrophone and camera bridge (PipeWire camera sources from Android frames), the\naudio route switch and sound that follows its picture while casting.",
  "units": {
    "system": [
      "rungic-plasma-network.service",
      "rungic-plasma-bluetooth.service",
      "rungic-plasma-modem.service",
      "rungic-network-mode.service",
      "rungic-network-mode.path"
    ],
    "user": [
      "rungic-plasma-media.service",
      "rungic-plasma-clipboard.service",
      "rungic-plasma-audio-follow.service",
      "rungic-communication-audio.service"
    ]
  },
  "obsolete": [
    "/usr/local/bin/moto-platform",
    "/usr/local/share/applications/dev.moto.Platform.desktop",
    "/usr/local/bin/moto-clipboard",
    "/usr/local/libexec/moto-android-network",
    "/usr/local/bin/moto-media-bridge",
    "/usr/local/bin/moto-audio-route",
    "/usr/local/bin/moto-camera-source",
    "/etc/systemd/system/moto-plasma-network.service",
    "/etc/systemd/system/multi-user.target.wants/moto-plasma-network.service",
    "/etc/systemd/user/moto-plasma-media.service",
    "/etc/systemd/user/moto-plasma-clipboard.service",
    "/usr/local/bin/wl-copy",
    "/usr/local/bin/wl-paste",
    "/usr/local/share/man/man1/wl-clipboard.1",
    "/usr/local/share/man/man1/wl-copy.1",
    "/usr/local/share/man/man1/wl-paste.1",
    "/usr/local/share/bash-completion/completions/wl-copy",
    "/usr/local/share/bash-completion/completions/wl-paste",
    "/usr/local/share/zsh/site-functions/_wl-copy",
    "/usr/local/share/zsh/site-functions/_wl-paste"
  ]
}
